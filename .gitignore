# ============================================================
# MiIsland .gitignore
# 目的：从根源上阻止个人/账号信息、构建产物、凭据被提交进仓库
# ============================================================

# 构建产物（可再生成，绝不入库）
bin/
obj/
publish/

# 打包产物（由 publish/ 压缩生成，仅作本地/Release 分发，非源码）
*.cipx
# CreateCipx 自动生成的发布包（与 CI-PeekShield 一致：本地产物，不入库，仅作为 Release asset）
cipx/

# IDE / 编辑器（可能含本机路径）
.vs/
.idea/
*.user
*.suo
*.userprefs

# 本地个人/凭据/配置（绝不入库）
*.settings.json
*.secrets.json
secrets.json
appsettings.*.json
*.secret
AppData/

# 本地调试配置文件（仅本机有效，含 ClassIsland 调试变量，对仓库无用）
Properties/launchSettings.json

# 操作系统
Thumbs.db
.DS_Store
